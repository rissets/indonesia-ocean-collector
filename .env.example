# Copernicus Marine Service (CMEMS)
# Register at: https://marine.copernicus.eu
COPERNICUSMARINE_SERVICE_USERNAME=your_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_password

# Global Fishing Watch
# Register at: https://globalfishingwatch.org/data-download
GFW_API_TOKEN=your_gfw_api_token

# ── Google Sheets export (sheets/export_to_sheets.py) ──────────────────────
# Option A: Composio (recommended)
# Get your API key at: https://app.composio.dev
# Then connect Google Sheets: composio add googlesheets
COMPOSIO_API_KEY=your_composio_api_key

# Option B: Google Service Account JSON (gspread fallback)
# Create a service account at: https://console.cloud.google.com
# Enable Sheets + Drive APIs, download JSON key
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json

# Optional: share the created sheet with this email
GOOGLE_SHARE_EMAIL=your_email@example.com

# Optional: override the default spreadsheet title
GOOGLE_SHEET_TITLE=Indonesia Ocean Fishing Ground Data

# Optional: write to an existing sheet instead of creating a new one
GOOGLE_SHEET_ID=
