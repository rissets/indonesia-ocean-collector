# Copernicus Marine Service (CMEMS)
# Register at: https://marine.copernicus.eu
COPERNICUSMARINE_SERVICE_USERNAME=your_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_password

# Global Fishing Watch
# Register at: https://globalfishingwatch.org/data-download
GFW_API_TOKEN=your_gfw_api_token

# PostgreSQL target
DB_HOST=217.217.252.155
DB_PORT=5432
DB_NAME=maritime-os
DB_USER=maritime-os
DB_PASSWORD=your_database_password

# Historical VMS source DB (used by scripts/import_vms_tracking.py).
# Keep the password in the real .env only. The script forces all source
# transactions to READ ONLY before dumping.
VMS_SOURCE_HOST=192.168.12.126
VMS_SOURCE_PORT=5432
VMS_SOURCE_DB=VMS
VMS_SOURCE_USER=execusr
VMS_SOURCE_PASSWORD=your_vms_source_password
VMS_SOURCE_CONNECT_TIMEOUT=15
MARITIME_TARGET_DSN=

# KKP Insight Datamart
KKP_DATAMART_BASE_URL=https://insight.kkp.go.id/datamart/api
KKP_DATAMART_TOKEN=your_kkp_datamart_bearer_token
